# Commands that should be applied only for interactive shells.
[[ $- == *i* ]] || return

HISTFILESIZE=100000
HISTSIZE=10000

shopt -s histappend
shopt -s checkwinsize
shopt -s extglob
shopt -s globstar 2>/dev/null || true
shopt -s checkjobs 2>/dev/null || true

alias ll='eza -a1l --color=always -I "*.DS_Store"'
alias neovim='nvim -u ~/.config/neovim/init.lua'

if [[ -r /opt/homebrew/etc/profile.d/bash_completion.sh ]]; then
  . /opt/homebrew/etc/profile.d/bash_completion.sh
fi

if declare -F _comp_load >/dev/null; then
  _comp_load ssh 2>/dev/null || true
fi
if declare -F _comp_cmd_ssh >/dev/null; then
  complete -F _comp_cmd_ssh mosh
fi

if [[ $TERM != dumb ]] && command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook bash)"
fi
